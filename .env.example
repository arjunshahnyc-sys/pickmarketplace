# ==============================================================================
# PICK MARKETPLACE - ENVIRONMENT VARIABLES
# ==============================================================================

# Database URL (Postgres — e.g. Neon via the Vercel Storage tab)
# Local dev: run `npx vercel env pull .env.local` after linking the project
DATABASE_URL="postgresql://user:password@host/dbname"

# Auth session signing secret (required for login/signup)
# Generate one with: openssl rand -base64 32
# Must also be set in Vercel: Settings -> Environment Variables
AUTH_SECRET=generate_a_random_secret_here

# Serper.dev API key — Google Shopping results in live search
# Without it, only Target results (if TARGET_API_KEY is set) are returned
SERPER_API_KEY=your_serper_api_key_here

# Target Redsky storefront API key (their public web key)
# Without it, Target results are skipped
TARGET_API_KEY=your_target_api_key_here

# Landed-cost ranking and display (item + shipping + duty + tax + fees).
# OFF unless set to exactly "true". Leave off until the customs rules in
# src/lib/landedCost/rules/destinations/ have been verified and filled in;
# unverified rules render as "estimate unavailable", never as numbers.
# NEXT_PUBLIC_LANDED_COST_ENABLED=true

# Assumed conversion spread over the ECB mid rate, in basis points
# (card network / issuer margin). Stated in every breakdown's assumptions
# line. Optional; defaults to 150 (1.5%). Rates come from /api/fx (ECB
# daily reference rates, no key needed).
# NEXT_PUBLIC_FX_SPREAD_BPS=150

# ==============================================================================
# SETUP:
# 1. Copy this file to .env.local
# 2. Fill in real values (never commit .env.local)
# 3. Mirror DATABASE_URL, AUTH_SECRET, SERPER_API_KEY, TARGET_API_KEY in
#    Vercel -> Settings -> Environment Variables
# 4. Restart the dev server: npm run dev
# ==============================================================================
